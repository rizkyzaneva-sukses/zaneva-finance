# ============ DATABASE ============
# Karakter khusus di password harus di-URL-encode (mis. @ jadi %40)
DATABASE_URL=postgresql://zaneva_app:GANTI_PASSWORD@localhost:5432/zaneva_finance?schema=public

# ============ WAJIB ============
# Untuk enkripsi cookie session (minimal 32 karakter) — generate dengan:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Password untuk user OWNER pertama (username: admin) saat `npx prisma db seed`.
# Ganti setelah login pertama.
SEED_ADMIN_PASSWORD=admin123

NODE_ENV=production
APP_BASE_URL=https://mutasi.mrrizky.my.id
NEXT_PUBLIC_APP_NAME=Zaneva Finance

# ============ OpenRouter (OCR screenshot mutasi + saran kode akun) ============
OPENROUTER_API_KEY=
# Model vision, bisa diganti kapan saja tanpa ubah kode
OPENROUTER_MODEL=google/gemini-2.5-flash
