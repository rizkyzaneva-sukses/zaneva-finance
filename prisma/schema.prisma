generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  ADMIN
  STAFF
  /// Pegangan petty cash (mis. gudang) — input manual untuk rekening kas yang
  /// di-assign, butuh ACC ADMIN/OWNER sebelum dianggap final.
  BENDAHARA
}

enum Bank {
  BCA
  MANDIRI
  BRI
  BNI
  /// Kas tunai (petty cash) — bukan rekening bank, tapi diperlakukan sama:
  /// punya saldo berjalan, masuk Kas & Bank di Neraca dan Arus Kas. Bisa lebih
  /// dari satu (mis. Kas Gudang, Kas Office).
  PETTY_CASH
  LAINNYA
}

enum StatusAcc {
  /// Dibuat/diubah oleh ADMIN atau OWNER — langsung final, tidak perlu ACC.
  DISETUJUI
  /// Dibuat/diubah oleh STAFF/BENDAHARA — menunggu verifikasi BENDAHARA dulu.
  /// Transaksi tetap dihitung di laporan selama menunggu — uangnya sudah
  /// benar-benar berpindah di bank, yang menunggu adalah pengesahan
  /// pencatatannya, bukan keberadaan transaksinya.
  MENUNGGU
  /// Sudah diverifikasi BENDAHARA, tapi menyentuh kode akun / catatan / split —
  /// harus difinalkan FINANCE (ADMIN/OWNER) sebelum dianggap sah.
  PERLU_FINANCE
}

enum Kelompok {
  HARTA
  UTANG
  MODAL
  PENDAPATAN
  PEMBELIAN
  BEBAN
  PINJAMAN
  ALOKASI
  LAINNYA
}

enum Laporan {
  NERACA
  LABA_RUGI
  TIDAK_ADA
}

enum AktivitasKas {
  OPERASI
  INVESTASI
  PENDANAAN
  /// Perpindahan kas/dana antar rekening atau ke kas tunai — bukan arus kas masuk/keluar usaha
  PINDAH_DANA
}

enum StatusKode {
  KOSONG
  SARAN_AI
  DIKONFIRMASI
}

enum Sumber {
  SCREENSHOT
  PDF
  MANUAL
}

enum AksiAudit {
  BUAT
  UBAH
  HAPUS
}

model User {
  id           String   @id @default(cuid())
  nama         String
  username     String   @unique
  passwordHash String
  /// Naik setiap password diganti. Sesi yang menyimpan angka lama langsung batal.
  tokenSesi    Int      @default(0)
  role         Role     @default(STAFF)
  aktif        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  transaksiDibuat        Transaksi[] @relation("TransaksiDibuat")
  transaksiDiubah        Transaksi[] @relation("TransaksiDiubah")
  transaksiDiAcc         Transaksi[] @relation("TransaksiDiAcc")
  transaksiDiverifikasi  Transaksi[] @relation("TransaksiDiverifikasi")
  jurnalPenyesuaian      JurnalPenyesuaian[]
  auditLogs       AuditLog[]
  periodeDisahkan PeriodeLaba[]
  distribusiAcc   DistribusiAlokasi[]
  dokumenDiunggah DokumenMutasi[]
  soDiunggah      StokOpname[]        @relation("SoDiunggah")
  soDiAcc         StokOpname[]        @relation("SoDiAcc")
  /// Brand yang boleh diakses. Kosong = semua brand (OWNER selalu semua).
  brandAkses      UserBrand[]
}

/// Penugasan pengguna ke brand. Pengguna yang punya penugasan hanya melihat dan
/// mengelola data rekening milik brand-brand itu.
model UserBrand {
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])

  @@id([userId, brandId])
  @@index([brandId])
}

model Rekening {
  id            String  @id @default(cuid())
  nama          String  @unique
  bank          Bank
  nomorRekening String?

  /// Titik nol pembukuan rekening ini — baris pertama rekap (kode 0000 Saldo).
  saldoAwal        Decimal  @default(0) @db.Decimal(18, 2)
  tanggalSaldoAwal DateTime @db.Date

  aktif     Boolean  @default(true)
  urutan    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Laporan per brand = rekening-rekening milik brand itu. Kosong = tidak masuk laporan brand manapun.
  brandId String?
  brand   Brand?  @relation(fields: [brandId], references: [id])

  transaksi Transaksi[]
  dokumen   DokumenMutasi[]
}

/// Gudang file mutasi bank (screenshot/PDF) per rekening.
/// File arsip tidak dihapus otomatis. `kedaluwarsaPada` kosong = simpan selamanya.
/// Catatan tetap ada walau file dihapus manual oleh ADMIN/OWNER.
model DokumenMutasi {
  id         String   @id @default(cuid())
  rekeningId String
  rekening   Rekening @relation(fields: [rekeningId], references: [id])

  /// Nama asli dari pengunggah — hanya untuk tampilan. File di disk memakai id.
  namaFile String
  tipe     String
  ukuran   Int

  /// Periode yang dicakup dokumen, format "YYYY-MM". Opsional.
  periode String?
  catatan String?

  diunggahOlehId String?
  diunggahOleh   User?    @relation(fields: [diunggahOlehId], references: [id])
  diunggahPada   DateTime @default(now())

  /// Kosong = arsip permanen. Terisi hanya untuk file sementara yang boleh dibersihkan.
  kedaluwarsaPada DateTime?
  /// Terisi setelah file benar-benar terhapus (otomatis atau manual). Catatan tetap ada.
  fileDihapusPada DateTime?

  @@index([rekeningId, diunggahPada])
  @@index([kedaluwarsaPada, fileDihapusPada])
}

model KodeAkun {
  id       String   @id @default(cuid())
  kode     String   @unique
  nama     String
  kelompok Kelompok

  /// Masuk laporan apa. null = belum diatur (sengaja dibedakan dari TIDAK_ADA,
  /// yang artinya sudah diputuskan memang tidak masuk laporan mana pun).
  laporan Laporan?

  /// Masuk bagian mana di Laporan Arus Kas. null = belum diatur.
  aktivitasKas AktivitasKas?

  /// Persentase dari laba yang dialokasikan ke kode ini, mis. 30.00 untuk 30%.
  /// Hanya relevan untuk kelompok ALOKASI. null = tidak dialokasikan dari laba.
  persenAlokasi Decimal? @db.Decimal(5, 2)

  /// Saldo alokasi yang sudah ada sebelum sistem ini dipakai. Titik awal saldo
  /// alokasi: saldo = saldoAwalAlokasi + Σ distribusi − Σ pemakaian.
  saldoAwalAlokasi Decimal @default(0) @db.Decimal(18, 2)

  /// Kode bawaan sistem (0000 Saldo) — tidak bisa dihapus/dinonaktifkan dari UI.
  sistem Boolean @default(false)

  aktif     Boolean  @default(true)
  urutan    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transaksi         Transaksi[]
  rincian           TransaksiRincian[]
  distribusi        DistribusiAlokasi[]
  contohKlasifikasi ContohKlasifikasi[]
  jurnalBaris       JurnalPenyesuaianBaris[]
}

/// Tutup buku bulanan: OWNER mengesahkan laba bersih satu bulan. Angka laba
/// disimpan sebagai snapshot dan jadi dasar pembagian alokasi.
model PeriodeLaba {
  id    String @id @default(cuid())
  tahun Int
  bulan Int // 1..12

  /// Laba bersih seluruh rekening pada bulan itu, saat disahkan.
  labaBersih Decimal @db.Decimal(18, 2)

  disetujuiOlehId String
  disetujuiOleh   User     @relation(fields: [disetujuiOlehId], references: [id])
  disetujuiPada   DateTime @default(now())

  distribusi DistribusiAlokasi[]

  @@unique([tahun, bulan])
}

/// Jatah alokasi satu kode akun dari laba satu periode, disahkan ADMIN (Finance).
model DistribusiAlokasi {
  id         String      @id @default(cuid())
  periodeId  String
  periode    PeriodeLaba @relation(fields: [periodeId], references: [id])
  kodeAkunId String
  kodeAkun   KodeAkun    @relation(fields: [kodeAkunId], references: [id])

  /// Persentase pada saat dibagikan — disalin supaya perubahan persen di masa
  /// depan tidak mengubah riwayat.
  persen  Decimal @db.Decimal(5, 2)
  nominal Decimal @db.Decimal(18, 2)

  disetujuiOlehId String
  disetujuiOleh   User     @relation(fields: [disetujuiOlehId], references: [id])
  disetujuiPada   DateTime @default(now())

  @@unique([periodeId, kodeAkunId])
  @@index([kodeAkunId])
}

model Transaksi {
  id         String    @id @default(cuid())
  rekeningId String
  rekening   Rekening  @relation(fields: [rekeningId], references: [id])
  kodeAkunId String?
  kodeAkun   KodeAkun? @relation(fields: [kodeAkunId], references: [id])

  tanggal DateTime @db.Date

  /// Tie-breaker urutan untuk transaksi di tanggal yang sama (menentukan saldo berjalan).
  urutanInput Int @default(0)

  keterangan String
  uangMasuk  Decimal @default(0) @db.Decimal(18, 2)
  uangKeluar Decimal @default(0) @db.Decimal(18, 2)

  /// Saldo berjalan hasil hitungan sistem.
  saldo Decimal @default(0) @db.Decimal(18, 2)

  /// Saldo yang terbaca di mutasi bank — hanya pembanding untuk rekonsiliasi.
  saldoBank Decimal? @db.Decimal(18, 2)

  catatan    String?
  statusKode StatusKode @default(KOSONG)
  sumber     Sumber     @default(SCREENSHOT)
  yakin      Boolean    @default(true)
  dedupeHash String

  /// ACC pencatatan oleh ADMIN/OWNER. Lihat komentar enum StatusAcc.
  statusAcc StatusAcc @default(DISETUJUI)
  accOlehId String?
  accOleh   User?     @relation("TransaksiDiAcc", fields: [accOlehId], references: [id])
  accPada   DateTime?

  /// Verifikasi penjualan kode 400. Kosong = belum dicek. Bukan ACC bendahara/finance.
  diverifikasiPada   DateTime?
  diverifikasiOlehId String?
  diverifikasiOleh   User?     @relation("TransaksiDiverifikasi", fields: [diverifikasiOlehId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?    @relation("TransaksiDibuat", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?    @relation("TransaksiDiubah", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Rincian split. Kalau ada, rincian inilah yang dihitung per kode akun di
  /// laporan; baris induk ini tetap jadi catatan asli dari bank dan tetap
  /// dipakai untuk saldo berjalan & rekonsiliasi.
  rincian TransaksiRincian[]

  @@unique([rekeningId, dedupeHash])
  @@index([rekeningId, tanggal, urutanInput])
  @@index([kodeAkunId])
  @@index([statusKode])
  @@index([statusAcc])
  @@index([diverifikasiPada])
}

/// Koreksi kode yang dipilih tim, dipakai lagi saat unggahan berikutnya.
/// Bukan fine-tune model — hanya contoh yang dimasukkan ke prompt dan aturan.
model ContohKlasifikasi {
  id         String   @id @default(cuid())
  /// Sidik jari keterangan (biasanya nama lawan), sudah dirapikan.
  kunci      String
  /// "masuk" atau "keluar"
  arah       String
  kodeAkunId String
  kodeAkun   KodeAkun @relation(fields: [kodeAkunId], references: [id], onDelete: Cascade)
  jumlah     Int      @default(1)
  terakhirPada DateTime @default(now())

  @@unique([kunci, arah])
  @@index([kodeAkunId])
}

model TransaksiRincian {
  id          String    @id @default(cuid())
  transaksiId String
  transaksi   Transaksi @relation(fields: [transaksiId], references: [id], onDelete: Cascade)
  kodeAkunId  String
  kodeAkun    KodeAkun  @relation(fields: [kodeAkunId], references: [id])

  /// Selalu positif; arah (masuk/keluar) mengikuti transaksi induknya.
  nominal    Decimal  @db.Decimal(18, 2)
  keterangan String?
  urutan     Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([transaksiId])
  @@index([kodeAkunId])
}

model AuditLog {
  id        String    @id @default(cuid())
  userId    String?
  user      User?     @relation(fields: [userId], references: [id])
  entitas   String
  entitasId String
  aksi      AksiAudit
  dataLama  Json?
  dataBaru  Json?
  createdAt DateTime  @default(now())

  @@index([entitas, entitasId])
  @@index([createdAt])
}

enum JenisSo {
  /// Persediaan awal pembukuan (harta awal). Masuk ke modal awal, bukan ke laba.
  AWAL
  /// Stok opname rutin tiap awal bulan. Selisihnya dengan SO sebelumnya jadi "Selisih HPP".
  BULANAN
}

/// Brand produk. Nama kanonik disimpan di sini; kunci = huruf+angka kecil saja,
/// supaya "BE SYAR'I" dan "BESYARI" dikenali sebagai brand yang sama.
model Brand {
  id        String   @id @default(cuid())
  nama      String   @unique
  kunci     String   @unique
  createdAt DateTime @default(now())

  rekening  Rekening[]
  produk    Produk[]
  soItem    StokOpnameItem[]
  penugasan UserBrand[]
  jurnal    JurnalPenyesuaian[]
}

/// Jurnal yang tidak menggerakkan rekening. Debit = kredit.
/// Reklasifikasi (deposit → beban) tidak dibalik. Akrual dibalik tanggal 1 bulan berikutnya.
model JurnalPenyesuaian {
  id         String   @id @default(cuid())
  brandId    String
  brand      Brand    @relation(fields: [brandId], references: [id])
  tanggal    DateTime @db.Date
  /// Nomor urut per brand, untuk tampilan JP-12.
  nomor      Int
  keterangan String

  /// true = akrual yang punya jurnal pembalik di awal bulan berikutnya.
  dibalik Boolean @default(false)

  /// Terisi kalau baris ini sendiri adalah jurnal pembalik.
  pembalikDariId String?             @unique
  pembalikDari   JurnalPenyesuaian?  @relation("Pembalik", fields: [pembalikDariId], references: [id], onDelete: Cascade)
  pembalik       JurnalPenyesuaian?  @relation("Pembalik")

  dibuatOlehId String?
  dibuatOleh   User?    @relation(fields: [dibuatOlehId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  baris JurnalPenyesuaianBaris[]

  @@unique([brandId, nomor])
  @@index([brandId, tanggal])
}

model JurnalPenyesuaianBaris {
  id         String             @id @default(cuid())
  jurnalId   String
  jurnal     JurnalPenyesuaian  @relation(fields: [jurnalId], references: [id], onDelete: Cascade)
  kodeAkunId String
  kodeAkun   KodeAkun           @relation(fields: [kodeAkunId], references: [id])
  debit      Decimal            @default(0) @db.Decimal(18, 2)
  kredit     Decimal            @default(0) @db.Decimal(18, 2)
  urutan     Int                @default(0)

  @@index([jurnalId])
  @@index([kodeAkunId])
}

/// Master produk: satu SKU satu baris, HPP per unit. Nilai persediaan = stok x HPP.
model Produk {
  id       String  @id @default(cuid())
  sku      String
  /// Kunci pencocokan: SKU dirapikan (spasi ganda, huruf besar/kecil) supaya "Adrea  Hoodie" = "adrea hoodie".
  skuKunci String  @unique
  brandId  String
  brand    Brand   @relation(fields: [brandId], references: [id])
  hpp      Decimal @default(0) @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  soItem StokOpnameItem[]

  @@index([brandId])
}

/// Satu kali stok opname untuk SEMUA produk sekaligus (multi brand).
model StokOpname {
  id    String  @id @default(cuid())
  jenis JenisSo

  /// Kapan tim menginput/menghitung (mis. tgl 1 atau 2 bulan berikutnya).
  tanggalInput DateTime @db.Date
  /// Stok ini berlaku PADA tanggal berapa. SO tgl 1-5 diperlakukan sebagai stok akhir bulan sebelumnya (default UI, bisa diubah).
  posisiPada   DateTime @db.Date
  catatan      String?

  jumlahSku  Int     @default(0)
  totalStok  Int     @default(0)
  totalNilai Decimal @default(0) @db.Decimal(18, 2)

  statusAcc StatusAcc @default(DISETUJUI)
  accOlehId String?
  accOleh   User?     @relation("SoDiAcc", fields: [accOlehId], references: [id])
  accPada   DateTime?

  diunggahOlehId String?
  diunggahOleh   User?    @relation("SoDiunggah", fields: [diunggahOlehId], references: [id])
  createdAt      DateTime @default(now())

  items StokOpnameItem[]

  @@index([posisiPada])
}

model StokOpnameItem {
  id           String     @id @default(cuid())
  stokOpnameId String
  stokOpname   StokOpname @relation(fields: [stokOpnameId], references: [id], onDelete: Cascade)
  produkId     String
  produk       Produk     @relation(fields: [produkId], references: [id])
  /// Snapshot saat SO diunggah, supaya perubahan master tidak mengubah Neraca bulan lalu.
  sku          String
  brandId      String
  brand        Brand      @relation(fields: [brandId], references: [id])
  stok         Int
  hpp          Decimal    @db.Decimal(18, 2)
  /// stok x hpp, dihitung sekali saat unggah.
  nilai        Decimal    @db.Decimal(18, 2)

  @@unique([stokOpnameId, produkId])
  @@index([brandId])
}
